# Copy to .env and fill in. Never commit .env.
MONGO_URI=mongodb://localhost:27017/sign2voice
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000
CLIENT_URL=http://localhost:5173
# Only used by `node createAdmin.js`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Python used by the "Open Sign2Voice" button. Must be the venv where desktop/requirements.txt is installed,
# e.g. C:/Users/you/Sign2Voice_Final/.venv/Scripts/python.exe
PYTHON_BIN=python
